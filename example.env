# TicketPro Environment Variables Blueprint Template
# Copy this file to local .env (never commit .env to version control)

APP_NAME=TicketPro
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-super-secret-key-for-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_SERVER=localhost
POSTGRES_USER=ticketpro_user
POSTGRES_PASSWORD=ticketpro_password
POSTGRES_DB=ticketpro_db
POSTGRES_PORT=5432
DATABASE_URL=sqlite:///./ticketpro.db

REDIS_HOST=localhost
REDIS_PORT=6379

RATE_LIMIT_PER_MINUTE=120
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=10
