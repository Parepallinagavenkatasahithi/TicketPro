# TicketPro Environment Variables Configuration Blueprint
# Copy this file to .env for local development

# Application Configuration
APP_NAME=TicketPro
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-super-secret-key-for-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL / SQLite fallback)
POSTGRES_SERVER=localhost
POSTGRES_USER=ticketpro_user
POSTGRES_PASSWORD=ticketpro_password
POSTGRES_DB=ticketpro_db
POSTGRES_PORT=5432
DATABASE_URL=sqlite:///./ticketpro.db

# Redis Cache & Background Queue (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=100
MAX_CONTENT_LENGTH_MB=10

# Storage Settings
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf,doc,docx,txt,zip,log

# Notification & Email Abstraction
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=placeholder_smtp_user
SMTP_PASSWORD=placeholder_smtp_password
EMAILS_FROM_EMAIL=support@ticketpro.internal
EMAILS_FROM_NAME=TicketPro Service Operations
